offline-android/**/*.aab
offline-android/**/*.aar
offline-android/**/*.ap_
offline-android/**/*.dex
offline-android/**/*.class
offline-android/**/*.keystore
offline-android/**/*.jks
offline-android/**/*.iml
offline-android/**/captures/
