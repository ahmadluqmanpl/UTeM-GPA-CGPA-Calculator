# Android / Capacitor build artifacts (scoped to the offline-android tree so
# the offline-windows/build source folder, which holds app icons, is kept)
offline-android/local.properties
offline-android/**/local.properties
offline-android/.gradle/
offline-android/**/.gradle/
offline-android/.idea/
offline-android/**/.idea/
offline-android/android/build/
offline-android/android/**/build/
offline-android/android/app/build/
