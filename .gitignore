offline-android/**/.cxx/
offline-android/**/*.hprof
offline-android/node_modules/
offline-android/**/node_modules/
# Capacitor-copied web assets and generated native config
offline-android/android/app/src/main/assets/public
offline-android/android/app/src/main/assets/capacitor.config.json
