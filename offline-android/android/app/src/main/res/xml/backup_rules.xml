<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 full-backup exclusions. allowBackup is false; these rules
     remain as defense-in-depth if a future build re-enables backup. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
